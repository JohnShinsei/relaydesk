# 本文件仅展示配置名，不含秘密；服务不会自动加载 .env。
# 在启动进程的受控环境中配置，不要提交真实密钥。
# 可选端口；监听地址始终为 127.0.0.1。
PORT=4317

# 默认只有模拟执行器，无需模型凭据。
# 可选 Hermes，先阅读 docs/hermes-integration.md。
# 真实 API / 模型 / 桌面 / 跨境链路本轮未验收。
# RELAYDESK_ENABLE_HERMES=1
# RELAYDESK_HERMES_URL=http://127.0.0.1:8642
# RELAYDESK_HERMES_API_KEY=<由日本端操作者配置的独立 Hermes API key>
# 对应 Hermes API_SERVER_KEY，不是 ChatGPT / Codex OAuth token。
# 不读取或复制 CLI 凭据，浏览器不能修改 URL/key/model/cwd。

# 可选旧 Codex exec，仅用本机核验过的官方 CLI 与正常登录。
# RELAYDESK_ENABLE_CODEX=1
# RELAYDESK_CODEX_PATH=<官方 Codex 可执行文件的绝对路径>
# RELAYDESK_CODEX_MODEL=<本机核验可用的模型名>
# 仅在人工确认旧 exec 进程已停止后对一次启动设置，不要常设。
# RELAYDESK_CODEX_ACK_INTERRUPTED=1

# 可选 Codex 原生驱动，见 docs/native-driver.md。
# RELAYDESK_ENABLE_CODEX_APP_SERVER=1
# RELAYDESK_CODEX_PATH=<官方 Codex 可执行文件的绝对路径>
# RELAYDESK_CODEX_MODEL=<本机核验可用的模型名>
# 可选固定测试目录的环境访问，仍保留 sandbox 与单次审批。
# RELAYDESK_CODEX_NATIVE_ENVIRONMENT=1
# 原生 unknown 必须核对精确 turn/run，不能用 ACK_INTERRUPTED 清除。

# 可选 Claude Agent SDK，见 docs/claude-integration.md；默认关闭。
# 需要独立官方 Code 登录；Desktop 登录不作为验证证据。
# RELAYDESK_ENABLE_CLAUDE=1
# RELAYDESK_CLAUDE_PATH=<本机官方 Claude CLI 的绝对 .exe 路径，可选>
# RELAYDESK_CLAUDE_MODEL=<本机核验可用的模型名，可选>
# RELAYDESK_CLAUDE_AUTH_MODE=subscription
# 固定目录 .data/claude-native-workspace；默认 CLI 为 SDK bundled native。
# 默认无工具；开启后 Read/Glob/Grep 仍需逐次审批；Bash/Edit/Write 拒绝。
# RELAYDESK_CLAUDE_ENVIRONMENT=1
# 仅接受第一方订阅登录，不使用 API key / Bearer / 云认证覆盖。
# 本地 CLI 官方 auth status/login 核验，不提取 Desktop cookie 或 OAuth。
# SDK 按需执行后关闭，不关闭用户已有 Desktop；内存差异尚未测量。
# unknown 恢复仅只读核对消息，不能证明终态，因此继续隔离且不重发。
