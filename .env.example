# Optional local HTTP port; host remains hard-coded to 127.0.0.1.
PORT=4317
# No credentials are required or accepted by the demonstration adapters.

# Optional real CLI. Export these in your shell; .env is not loaded automatically.
# Enable only after verifying the official CLI and its normal ChatGPT login locally.
# RELAYDESK_ENABLE_CODEX=1
# RELAYDESK_CODEX_PATH=/Applications/Codex.app/Contents/Resources/codex
# RELAYDESK_CODEX_MODEL=replace-with-a-verified-model-name
# One-time recovery only AFTER manually checking old CLI processes have stopped.
# Do not persist this acknowledgement in your normal launch environment.
# RELAYDESK_CODEX_ACK_INTERRUPTED=1
# No API keys, OAuth tokens or credentials belong in this file.
